# ==============================================================================
# POAS – Paschim Odisha Agrani Sangathana Environment Configuration
# Copy this file to .env before starting the development or production server
# ==============================================================================

# Database Connection (SQLite default for self-contained portability; PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# Session & Authentication Secrets
# Generate a random 32+ character string in production (e.g. `openssl rand -base64 32`)
AUTH_SECRET="poas-bhubaneswar-secure-secret-key-2026-production"
NEXTAUTH_SECRET="poas-bhubaneswar-secure-secret-key-2026-production"
NEXTAUTH_URL="http://localhost:3000"

# Initial Seed Admin Credentials (used during `npm run db:seed`)
DEFAULT_ADMIN_EMAIL="admin@poasbhubaneswar.org"
DEFAULT_ADMIN_PASSWORD="POAS@2026!Admin"

# Public Site Metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="POAS – Paschim Odisha Agrani Sangathana"
