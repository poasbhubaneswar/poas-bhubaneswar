datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         String     @default("SUPER_ADMIN")
  image        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Event {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  description      String
  fullDetails      String?
  venue            String
  location         String?
  eventDate        DateTime
  startTime        String?
  endTime          String?
  bannerImage      String?
  images           String?        // JSON array of multiple image URLs for Instagram carousel
  isPublished      Boolean        @default(true)
  registrationOpen Boolean        @default(false)
  maxAttendees     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  schedules        ScheduleItem[]

  @@map("events")
}

model ScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlot    String
  title       String
  description String?
  speaker     String?
  orderIndex  Int      @default(0)

  @@map("schedule_items")
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  images      String?   // JSON array of multiple image URLs for Instagram carousel
  author      String    @default("POAS Editorial")
  category    String    @default("Cultural Heritage")
  publishedAt DateTime? @default(now())
  isPublished Boolean   @default(true)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

model Meeting {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  date         DateTime?
  location     String?   @default("Bhubaneswar")
  participants String?
  description  String
  coverImage   String?
  images       String?   // JSON array of multiple image URLs
  isPublished  Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("meetings")
}

model OfficeBearer {
  id           String   @id @default(cuid())
  name         String
  nameOdia     String?
  designation  String
  category     String   @default("GOVERNING_BODY") // GOVERNING_BODY, EXECUTIVE_BODY, PATRON
  phone        String?
  email        String?
  imageUrl     String?
  bio          String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("office_bearers")
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  caption      String?
  imageUrl     String
  category     String   @default("Celebrations")
  aspect       String   @default("landscape")
  isFeatured   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("gallery_items")
}

model Dignitary {
  id           String   @id @default(cuid())
  name         String
  designation  String
  constituency String?
  bio          String?
  imageUrl     String?
  category     String   @default("MLA")
  displayOrder Int      @default(0)
  isFeatured   Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("dignitaries")
}

model CommitteeMember {
  id           String   @id @default(cuid())
  name         String
  roleTitle    String
  bio          String?
  phone        String?
  email        String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("committee_members")
}

model MemberInquiry {
  id             String   @id @default(cuid())
  name           String
  phone          String
  email          String?
  city           String   @default("Bhubaneswar")
  nativeDistrict String?
  membershipTier String   @default("LIFETIME") // LIFETIME (₹1000) or YEARLY (₹100)
  membershipFee  Int      @default(1000)      // 1000 or 100
  paymentStatus  String   @default("PENDING") // PENDING, PAID
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())

  @@map("member_inquiries")
}

model DonationPledge {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  amount         Float
  purpose        String   @default("General Fund")
  status         String   @default("PLEDGED")
  transactionRef String?
  createdAt      DateTime @default(now())

  @@map("donation_pledges")
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("contact_messages")
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
